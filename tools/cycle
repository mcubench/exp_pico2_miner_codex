#!/usr/bin/env bash

set -euo pipefail
source "$(dirname -- "$0")/common.sh"

arch="${1:-}"
case "${arch}" in
    arm|riscv) ;;
    *) die "usage: tools/cycle arm|riscv" ;;
esac

mkdir -p "${PROJECT_ROOT}/logs"
"${PROJECT_ROOT}/tools/build" arm
"${PROJECT_ROOT}/tools/build" riscv
"${PROJECT_ROOT}/tools/flash" "${arch}"
case "${arch}" in
    arm) expected_arch=ARM-M33 ;;
    riscv) expected_arch=RISCV-HAZARD3 ;;
esac
"${PROJECT_ROOT}/tools/monitor" --seconds "${MONITOR_SECONDS:-45}" --require-pass \
    --expected-arch "${expected_arch}" --expected-source "$(source_identity)" \
    | tee "${PROJECT_ROOT}/logs/${arch}-latest.log"
printf 'CYCLE:PASS arch=%s\n' "${arch}"
