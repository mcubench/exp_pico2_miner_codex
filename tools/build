#!/usr/bin/env bash

set -euo pipefail
source "$(dirname -- "$0")/common.sh"

arch="${1:-}"
case "${arch}" in
    arm)
        platform=rp2350-arm-s
        triple=arm-none-eabi
        explicit_toolchain="${ARM_TOOLCHAIN:-}"
        ;;
    riscv)
        platform=rp2350-riscv
        triple=riscv32-pico-elf
        explicit_toolchain="${RISCV_TOOLCHAIN:-}"
        ;;
    *)
        die "usage: tools/build arm|riscv"
        ;;
esac

sdk="$(find_sdk)" || die "Pico SDK not found. Set PICO_SDK_PATH or install it under ${PICO_HOME}/sdk."
cmake_bin="$(find_cmake)" || die "CMake not found."
ninja_bin="$(find_ninja)" || die "Ninja not found."
toolchain="$(find_toolchain "${triple}" "${explicit_toolchain}")" || die "${triple} toolchain not found."
picotool_bin="$(find_picotool)" || die "picotool not found."
export PATH="$(dirname "${picotool_bin}"):${PATH}"
build_dir="${PROJECT_ROOT}/build/${arch}"
miner_sys_clock_khz="${MINER_SYS_CLOCK_KHZ:-150000}"
miner_vreg_mv="${MINER_VREG_MV:-1100}"
miner_qmi_clkdiv="${MINER_QMI_CLKDIV:-3}"
miner_profile="${MINER_PROFILE:-0}"
miner_source_id="$(source_identity)"

[[ "${miner_sys_clock_khz}" =~ ^[0-9]+$ ]] \
    || die "MINER_SYS_CLOCK_KHZ must be an integer"
(( miner_sys_clock_khz >= 12000 && miner_sys_clock_khz <= 590000 )) \
    || die "MINER_SYS_CLOCK_KHZ must be between 12000 and 590000"
case "${miner_vreg_mv}" in
    1100|1150|1200|1250|1300|1350|1400|1500|1600) ;;
    *) die "MINER_VREG_MV must be one of: 1100 1150 1200 1250 1300 1350 1400 1500 1600" ;;
esac
case "${miner_qmi_clkdiv}" in
    3|4|5) ;;
    *) die "MINER_QMI_CLKDIV must be one of: 3 4 5" ;;
esac
(( miner_sys_clock_khz <= 130000 * miner_qmi_clkdiv )) \
    || die "QMI SCK would exceed the 130000 kHz campaign limit"
[[ "${miner_profile}" == 0 || "${miner_profile}" == 1 ]] \
    || die "MINER_PROFILE must be 0 or 1"

printf 'CONFIG arch=%s platform=%s\n' "${arch}" "${platform}"
printf 'CONFIG sdk=%s\n' "${sdk}"
printf 'CONFIG toolchain=%s\n' "${toolchain}"
printf 'CONFIG miner_sys_clock_khz=%s\n' "${miner_sys_clock_khz}"
printf 'CONFIG miner_vreg_mv=%s\n' "${miner_vreg_mv}"
printf 'CONFIG miner_qmi_clkdiv=%s\n' "${miner_qmi_clkdiv}"
printf 'CONFIG miner_source_id=%s\n' "${miner_source_id}"
printf 'CONFIG miner_profile=%s\n' "${miner_profile}"

"${cmake_bin}" -S "${PROJECT_ROOT}" -B "${build_dir}" -G Ninja \
    -DCMAKE_MAKE_PROGRAM="${ninja_bin}" \
    -DCMAKE_BUILD_TYPE=Debug \
    -DPICO_AGENT_DUAL_BUILD=ON \
    -DPICO_BOARD=pico2 \
    -DPICO_PLATFORM="${platform}" \
    -DPICO_SDK_PATH="${sdk}" \
    -DPICO_TOOLCHAIN_PATH="${toolchain}" \
    -DMINER_SYS_CLOCK_KHZ="${miner_sys_clock_khz}" \
    -DMINER_VREG_MV="${miner_vreg_mv}" \
    -DMINER_QMI_CLKDIV="${miner_qmi_clkdiv}" \
    -DMINER_PROFILE="${miner_profile}" \
    -DMINER_SOURCE_ID="${miner_source_id}"

"${cmake_bin}" --build "${build_dir}"
printf 'BUILD:PASS arch=%s uf2=%s\n' "${arch}" "${build_dir}/pico2_agent.uf2"
